# Copy this file to ".env" in this same folder for local "dotnet run" convenience —
# it's loaded automatically on startup (via DotNetEnv) as an alternative to
# "dotnet user-secrets set". ".env" is git-ignored — never commit a real bot token.
# A variable already set in the real environment always wins over this file.

Telegram__BotToken=123456789:AAExampleTokenFromBotFather
